# Скопируй в apps/api/.env и заполни реальными значениями.

# Core
NODE_ENV=development
PORT=4000

# Postgres (Neon.tech)
# Формат: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Redis (Upstash) — для OTP-кодов и очередей BullMQ
REDIS_URL=

# JWT
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# SMS (Eskiz.uz)
# Если пусто — SMS не отправляется, код печатается в лог (dev-fallback).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# Фиксированный OTP-код в dev-режиме (не используйте в production)
DEV_OTP_CODE=0000

# S3 (Backblaze B2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-005

# Meilisearch
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Payments
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
